{
  "name": "agent-rocky",
  "version": "0.1.0",
  "description": "Rocky (Project Hail Mary) sound notifications for coding agents, with a Codex pet slot. Amaze amaze amaze!",
  "type": "module",
  "bin": {
    "agent-rocky": "scripts/rocky.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check scripts/rocky.mjs && node --check scripts/pet.mjs && node --check scripts/build-site.mjs && node --check site/app.js && node --check site/theme.js && node --check scripts/build-gemini.mjs && node --check scripts/check-package.mjs && node scripts/check-project.mjs",
    "doctor": "node scripts/rocky.mjs doctor",
    "site": "node scripts/build-site.mjs",
    "gemini": "node scripts/build-gemini.mjs",
    "test:package": "node scripts/check-package.mjs"
  },
  "files": [
    "scripts/rocky.mjs",
    "scripts/pet.mjs",
    "audio",
    "pets",
    "plugin.json",
    ".claude-plugin",
    ".agents/plugins",
    "hooks",
    "docs",
    "CHANGELOG.md",
    "assets/previews/banner-dark.png",
    "assets/previews/banner-light.png",
    "assets/previews/amaze-amaze-amaze.gif",
    "assets/previews/fist-my-bump.gif",
    "assets/previews/we-die.gif",
    "assets/previews/not-enough.gif",
    "assets/previews/how-much-astrophage.gif",
    "assets/previews/eridian-question.gif",
    "assets/previews/pet-idle.gif",
    "assets/previews/pet-working.gif",
    "assets/previews/pet-waiting.gif",
    "assets/previews/pet-review.gif",
    "assets/previews/pet-failure.gif",
    "assets/previews/pet-idle.png",
    "assets/previews/NOTICE.md",
    "skills",
    "gemini-extension.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitchtech/agent-rocky.git"
  },
  "homepage": "https://mitchtech.github.io/agent-rocky/",
  "bugs": "https://github.com/mitchtech/agent-rocky/issues",
  "author": "Michael J. Mitchell <michael@mitchtech.net>",
  "license": "MIT",
  "keywords": [
    "project-hail-mary",
    "rocky",
    "eridian",
    "andy-weir",
    "audio",
    "notifications",
    "coding-agents",
    "claude-code",
    "codex",
    "gemini-cli",
    "gemini-cli-extension",
    "codex-pet",
    "statusline"
  ]
}
