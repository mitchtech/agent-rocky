{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "agent-rocky-sessionstart",
            "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.AGENT_ROCKY_PLUGIN_ROOT,'scripts','rocky.mjs')).href).then(m=>m.main(['hook','--agent','gemini'])).then(c=>{process.exitCode=c}).catch(()=>{console.log('{}')})\"",
            "env": {
              "AGENT_ROCKY_PLUGIN_ROOT": "${extensionPath}"
            },
            "timeout": 5000
          }
        ]
      }
    ],
